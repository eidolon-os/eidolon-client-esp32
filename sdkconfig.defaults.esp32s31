# ESP32-S31 (ESP32-S31-Korvo-1). ESP-IDF 6.1 only: esp32s31 is a preview target
# there and absent from 6.0.

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# The memory policy the ESP32-S3 defaults carry, which this file was written
# without. IDF's own default for ALWAYSINTERNAL is 16 kB, meaning every
# allocation up to that size is taken from internal SRAM first — and esp_peer's
# ICE agent asks for it with a plain calloc of 5,024 bytes. On the S3 boards
# that lands in PSRAM because the threshold is 2 kB; here it was forced
# internal, and the board could hold a signalling session but never open a peer
# connection: "Not enough memory for agent", every time, until the retries had
# eaten the internal heap down to a few kB.
#
# RESERVE_INTERNAL rises with it: lowering the threshold sends ordinary
# allocations to PSRAM, and what stays behind is the traffic that genuinely
# cannot leave — I2S descriptors, the RGB panel's bounce buffers, Wi-Fi's DMA
# buffers — so the pool kept back for them has to be the larger one.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304

# TLS record buffers are 16 kB in and 4 kB out per connection, and this board
# holds a WSS signalling socket beside two DTLS-SRTP peers. None of it is DMA.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# esp_peer compiles src/dtls_srtp_v6.c only on IDF >= 6, and that implementation
# generates its own self-signed DTLS certificate. The IDF 5 path (dtls_srtp.c)
# does not, which is why no ESP32-S3 board needs these.
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
CONFIG_MBEDTLS_PEM_WRITE_C=y

# The shared defaults keep the Wi-Fi RX buffers small (6/8) because they were
# taken from an ESP32-C3 board that had to. This module has 16 MB of PSRAM, and
# SPIRAM_TRY_ALLOCATE_WIFI_LWIP above raises the AMPDU RX block-ack window
# default to 16 — which esp_wifi then rejects at compile time, since the window
# may exceed neither the dynamic RX buffer count nor twice the static one.
# Give this SoC buffers matched to the window instead of shrinking the window.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=16
