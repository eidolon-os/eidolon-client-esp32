choice DISPLAY_STYLE
    prompt "Select display style"
    default USE_DEFAULT_MESSAGE_STYLE
    help
        Select display style for Xiaozhi device

    config USE_DEFAULT_MESSAGE_STYLE
        bool "Enable default message style"

    config USE_WECHAT_MESSAGE_STYLE
        bool "Enable WeChat Message Style"

    config USE_EMOTE_MESSAGE_STYLE
        bool "Emote animation style"
        depends on BOARD_TYPE_ESP_BOX || BOARD_TYPE_ESP_BOX_3 \
            || BOARD_TYPE_ESP_VOCAT || BOARD_TYPE_LICHUANG_DEV_S3 || BOARD_TYPE_RYMCU_BIGSMART \
            || BOARD_TYPE_ESP_SENSAIRSHUTTLE
endchoice

config USE_MULTILINE_CHAT_MESSAGE
    bool "Use multiline chat message display (default mode only)"
    depends on USE_DEFAULT_MESSAGE_STYLE
    default n
    help
        When enabled, the chat message area in the default display mode shows
        multiple wrapped lines that grow upward from the bottom of the screen,
        with auto-adaptive height.
        When disabled (default), a single-line horizontally scrolling label
        is shown at the bottom of the screen.

choice WAKE_WORD_TYPE
    prompt "Wake Word Implementation Type"
    default USE_AFE_WAKE_WORD if (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
    default WAKE_WORD_DISABLED
    help
        Choose the type of wake word implementation to use

    config WAKE_WORD_DISABLED
        bool "Disabled"
        help
            Disable wake word detection

    config USE_ESP_WAKE_WORD
        bool "Wakenet model without AFE"
        depends on IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C5 || IDF_TARGET_ESP32C6 || (IDF_TARGET_ESP32 && SPIRAM)
        help
            Support ESP32 C3、ESP32 C5 与 ESP32 C6, and (ESP32 with PSRAM)

    config USE_AFE_WAKE_WORD
        bool "Wakenet model with AFE"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
        help
            Support AEC if available, requires ESP32 S3 and PSRAM

    config USE_CUSTOM_WAKE_WORD
        bool "Multinet model (Custom Wake Word)"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
        help
            Requires ESP32 S3 and PSRAM

endchoice

config CUSTOM_WAKE_WORD
    string "Custom Wake Word"
    default "xiao tu dou"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word, use pinyin for Chinese, separated by spaces

config CUSTOM_WAKE_WORD_DISPLAY
    string "Custom Wake Word Display"
    default "小土豆"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Greeting sent to the server after wake word detection

config CUSTOM_WAKE_WORD_THRESHOLD
    int "Custom Wake Word Threshold (%)"
    default 20
    range 1 99
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word Threshold, range 1-99, the smaller the more sensitive, default 20

config SEND_WAKE_WORD_DATA
    bool "Send Wake Word Data"
    default y
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Send wake word data to the server as the first message of the conversation and wait for response

config WAKE_WORD_DETECTION_IN_LISTENING
    bool "Enable Wake Word Detection in Listening Mode"
    default n
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Enable wake word detection while in listening mode.
        When enabled, the device can detect wake word during listening,
        which allows interrupting the current conversation.
        When disabled (default), wake word detection is turned off during listening.

config USE_AUDIO_PROCESSOR
    bool "Enable Audio Noise Reduction"
    default y
    depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4) && SPIRAM
    help
        Requires ESP32 S3 and PSRAM

config USE_DEVICE_AEC
    bool "Enable Device-Side AEC"
    default n
        depends on USE_AUDIO_PROCESSOR && (BOARD_TYPE_ESP_BOX_3 || BOARD_TYPE_ESP_BOX || BOARD_TYPE_ESP_BOX_LITE \
        || BOARD_TYPE_LICHUANG_DEV_S3 || BOARD_TYPE_RYMCU_BIGSMART || BOARD_TYPE_ESP_KORVO2_V3 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_75|| BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_75C || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_83\
        || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_2_06 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4_3 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_5 \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_7B \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_3_4C || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4C || BOARD_TYPE_ESP_S3_LCD_EV_Board_2 || BOARD_TYPE_YUNLIAO_S3 \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_7 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_8 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_10_1 \
        || BOARD_TYPE_ESP_VOCAT || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_3_49 || BOARD_TYPE_WAVESHARE_ESP32_S3_RLCD_4_2 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_85B || BOARD_TYPE_ZHENGCHEN_CAM || BOARD_TYPE_ZHENGCHEN_CAM_ML307 \
        || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_4_3C || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_54 || BOARD_TYPE_WAVESHARE_ESP32_S3_LCD_0_85 || BOARD_TYPE_AI_VOX3 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_43C || BOARD_TYPE_ATK_DNESP32S3_BOX3 || BOARD_TYPE_M5STACK_STACKCHAN)
    help
        To work properly, device-side AEC requires a clean output reference path from the speaker signal and physical acoustic isolation between the microphone and speaker.

choice EIDOLON_DEVICE_AEC_AFE_MODE
    prompt "Device-Side AEC AFE Mode"
    default EIDOLON_DEVICE_AEC_AFE_MODE_LOW_COST
    depends on USE_DEVICE_AEC
    help
        Select the ESP-SR AFE mode used by the device-side AEC capture source.
        Low cost is safer for RAM/CPU headroom. High performance can improve
        echo suppression quality on ESP32-S3/P4 boards with PSRAM, but should
        be validated on the target board under real playback volume.

    config EIDOLON_DEVICE_AEC_AFE_MODE_LOW_COST
        bool "Low cost"

    config EIDOLON_DEVICE_AEC_AFE_MODE_HIGH_PERF
        bool "High performance"

endchoice

config USE_SERVER_AEC
    bool "Enable Server-Side AEC (Unstable)"
    default n
    depends on USE_AUDIO_PROCESSOR
    help
        To work perperly, server-side AEC requires server support

config USE_AUDIO_DEBUGGER
    bool "Enable Audio Debugger"
    default n
    help
        Enable audio debugger, send audio data through UDP to the host machine

config EIDOLON_AEC_QUALIFICATION
    bool "Enable standalone AEC qualification mode"
    default n
    depends on USE_DEVICE_AEC
    help
        Boot into a standalone USB-serial AEC qualification runner instead of
        the normal application. This mode does not connect to WiFi or LiveKit;
        it plays deterministic test audio, captures raw/reference/AEC PCM, and
        emits framed test events for the host-side qualification script.

config EIDOLON_AEC_QUALIFICATION_PLAYBACK_VOLUME
    int "AEC qualification playback volume"
    default 75
    range 0 100
    depends on EIDOLON_AEC_QUALIFICATION
    help
        Output volume used by the standalone AEC qualification runner. This is
        intentionally test-only so qualification can validate real acoustic
        playback without changing the normal application volume.

config EIDOLON_AEC_QUALIFICATION_BOX_REF_CHANNEL
    int "ESP-BOX style ES7210 reference channel for AEC qualification"
    default 1
    range 1 3
    depends on EIDOLON_AEC_QUALIFICATION && BOARD_TYPE_ESP_BOX_3
    help
        Select the ES7210 channel used as playback reference during standalone
        AEC qualification on ESP-BOX style boards. Channel 1 is the validated
        ESP-BOX-3 playback reference with the current codec channel ordering.
        Channels 2 and 3 are exposed only for qualification comparison.

config EIDOLON_AEC_QUALIFICATION_STACKCHAN_REF_CHANNEL
    int "StackChan ES7210 reference channel for AEC qualification"
    default 1
    range 1 3
    depends on EIDOLON_AEC_QUALIFICATION && BOARD_TYPE_M5STACK_STACKCHAN
    help
        Select the ES7210 channel used as the candidate playback reference
        during standalone AEC qualification on M5Stack StackChan. This is for
        reference-channel verification only; the normal firmware must not treat
        StackChan as barge-in capable until a clean reference path is validated.

menu "WiFi Configuration Method"
    help
        WiFi Configuration Method Selection
    config USE_HOTSPOT_WIFI_PROVISIONING
        bool "Hotspot"
        default y
        help
            Use WiFi Hotspot to transmit WiFi configuration data
    config USE_ACOUSTIC_WIFI_PROVISIONING
        bool "Acoustic"
        help
            Use audio signal to transmit WiFi configuration data

    config USE_ESP_BLUFI_WIFI_PROVISIONING
        bool "Esp Blufi"
        help
            Use esp blufi protocol to transmit WiFi configuration data
        select BT_ENABLED
        select BT_BLE_42_FEATURES_SUPPORTED
        select BT_BLE_BLUFI_ENABLE
        select MBEDTLS_DHM_C
endmenu

config AUDIO_DEBUG_UDP_SERVER
    string "Audio Debug UDP Server Address"
    default "192.168.2.100:8000"
    depends on USE_AUDIO_DEBUGGER
    help
        UDP server address, format: IP:PORT, used to receive audio debugging data

config RECEIVE_CUSTOM_MESSAGE
    bool "Enable Custom Message Reception"
    default n
    help
        Enable custom message reception, allow the device to receive custom messages from the server (preferably through the MQTT protocol)

menu "Camera Configuration"
    depends on !IDF_TARGET_ESP32

    comment "Warning: Please read the help text before modifying these settings."

    config XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        bool "Allow JPEG Input"
        default n
        help
            Allow JPEG Input format for the camera.

            This option may need to be enabled when using a USB camera.

            Not currently supported when used simultaneously with XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE.

    config XIAOZHI_ENABLE_HARDWARE_JPEG_ENCODER
        bool "Enable Hardware JPEG Encoder"
        default y
        depends on SOC_JPEG_ENCODE_SUPPORTED
        help
            Use hardware JPEG encoder on ESP32-P4 to encode image to JPEG.
            See https://docs.espressif.com/projects/esp-idf/en/stable/esp32p4/api-reference/peripherals/jpeg.html for more details.

    config XIAOZHI_ENABLE_HARDWARE_JPEG_DECODER
        bool "Enable Hardware JPEG Decoder"
        default n
        depends on SOC_JPEG_DECODE_SUPPORTED && XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        help
            Use hardware JPEG decoder on ESP32-P4 to decode JPEG to image.
            See https://docs.espressif.com/projects/esp-idf/en/stable/esp32p4/api-reference/peripherals/jpeg.html for more details.

    config XIAOZHI_ENABLE_CAMERA_DEBUG_MODE
        bool "Enable Camera Debug Mode"
        default n
        help
            Enable camera debug mode, print camera debug information to the console.
            Only works on boards that support camera.

    config XIAOZHI_ENABLE_CAMERA_ENDIANNESS_SWAP
        bool "Enable software camera buffer endianness swapping"
        default n
        depends on !CAMERA_SENSOR_SWAP_PIXEL_BYTE_ORDER
        help
            This option treats the camera buffer as a uint16_t[] array and performs byte-swapping (endianness conversion) on each element.

            Should only be modified by development board integration engineers.

            **Incorrect usage may result in incorrect image colors!**

            ATTENTION: If the option CAMERA_SENSOR_SWAP_PIXEL_BYTE_ORDER is available for your sensor, please use that instead.

    menuconfig XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE
        bool "Enable Camera Image Rotation"
        default n
        depends on !XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        help
            Enable camera image rotation, rotate the camera image to the correct orientation.
            - On ESP32-P4, rotation is handled by PPA hardware.
            - On other chips, rotation is done in software with performance cost.
            - For 180° rotation, use HFlip + VFlip instead of this option.

            Not currently supported when used simultaneously with XIAOZHI_CAMERA_ALLOW_JPEG_INPUT.

    if XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE
        choice XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE
            prompt "Camera Image Rotation Angle (clockwise)"
            default XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_90
            help
                Camera image rotation angle.
            config XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_90
                bool "90°"
            config XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_270
                bool "270°"
            comment "For 180° rotation, use HFlip + VFlip instead of this option"
        endchoice
    endif
endmenu

menu "TAIJIPAI_S3_CONFIG"
    depends on BOARD_TYPE_TAIJI_PI_S3
    choice I2S_TYPE_TAIJIPI_S3
        prompt "taiji-pi-S3 I2S Type"
        default TAIJIPAI_I2S_TYPE_STD
        help
            I2S 类型选择
        config TAIJIPAI_I2S_TYPE_STD
            bool "I2S Type STD"
        config TAIJIPAI_I2S_TYPE_PDM
            bool "I2S Type PDM"
    endchoice

    config I2S_USE_2SLOT
    bool "Enable I2S 2 Slot"
    default y
    help
        启动双声道
endmenu

menu "Eidolon Hub"
    depends on BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_2_06 || BOARD_TYPE_ESP_BOX_3 || BOARD_TYPE_ATK_DNESP32S3 || BOARD_TYPE_M5STACK_CORE_S3 || BOARD_TYPE_M5STACK_STACKCHAN

    config EIDOLON_HUB_MODE
        bool "Enable Eidolon Hub mDNS discovery and config"
        default y
        help
            After WiFi connects, discover Eidolon Hub via mDNS and fetch LiveKit
            config from GET /api/config. Does not use Xiaozhi cloud OTA URL for
            mqtt/websocket. Firmware upgrade from Hub is phase 2.

    config EIDOLON_MDNS_SERVICE_TYPE
        string "mDNS service type (without ._tcp suffix)"
        default "_eidolon-hub"
        depends on EIDOLON_HUB_MODE

    config EIDOLON_MDNS_QUERY_TIMEOUT_MS
        int "mDNS query timeout (ms)"
        default 8000
        depends on EIDOLON_HUB_MODE

    config EIDOLON_MDNS_PROBE_RETRIES
        int "Fast mDNS probe retries when browse is empty"
        default 3
        depends on EIDOLON_HUB_MODE

    config EIDOLON_MDNS_MAX_RETRIES
        int "Hub activation max retries"
        default 10
        depends on EIDOLON_HUB_MODE

    config EIDOLON_CONFIG_HTTP_TIMEOUT_MS
        int "Hub config HTTP timeout (ms)"
        default 15000
        depends on EIDOLON_HUB_MODE

    config EIDOLON_AUTO_JOIN_ON_ACTIVATION
        bool "Automatically join LiveKit room after device activation"
        default n
        depends on EIDOLON_HUB_MODE
        help
            When enabled, joins the LiveKit room as soon as device activation
            completes (Hub config saved to NVS). When disabled, use on-screen
            button or BOOT short press to join manually.

    config EIDOLON_DEV_DISABLE_AUTO_SHUTDOWN
        bool "Development mode: disable idle PMIC power-off"
        default n
        depends on EIDOLON_HUB_MODE
        help
            Keep the board powered while developing over USB. Product builds
            should leave this disabled so battery idle auto-shutdown remains
            active.

    # Interaction mode = one of three, selected by these two mutually-exclusive
    # bools (HALF_DUPLEX depends on !PTT so at most one is y):
    #   PTT=y                 -> ptt          (hold-to-talk)
    #   PTT=n, HALF_DUPLEX=y   -> half_duplex  (auto-record, mic closed on playback)
    #   PTT=n, HALF_DUPLEX=n   -> full_duplex  (open mic + AEC + barge-in)
    config EIDOLON_INTERACTION_MODE_PTT
        bool "Push-to-talk (hold to talk)"
        default y
        depends on EIDOLON_HUB_MODE
        help
            Hold a button to talk, release to send (walkie-talkie). The mic is
            closed except while held, so a board with no usable echo cancellation
            never records its own playback, and the turn boundary is explicit
            (no VAD/EOT guessing). For wearables / button devices (e.g. waveshare
            2.06). Disable to pick half_duplex or full_duplex below.

    config EIDOLON_INTERACTION_MODE_HALF_DUPLEX
        bool "Half-duplex (auto open-mic, closed during playback, no barge-in)"
        default n
        depends on EIDOLON_HUB_MODE && !EIDOLON_INTERACTION_MODE_PTT
        help
            Auto-record after session start (no button) but close the mic while
            the agent is speaking, so a board with NO device AEC never records
            its own playback. STT is committed by the server end-of-turn (EOT)
            judgment (same as full-duplex); the agent is NOT interruptible.
            For boards without a validated AEC reference (e.g. m5stack-stackchan).
            When this and PTT are both n, the mode is full-duplex (open mic +
            device AEC + barge-in) — the setting for boards with good AEC
            (e.g. esp-box-3).

    config EIDOLON_PTT_RELEASE_TAIL_MS
        int "PTT release capture tail (ms)"
        range 0 500
        default 150
        depends on EIDOLON_INTERACTION_MODE_PTT
        help
            Keep capture open briefly after touch release before publishing
            ptt=false. This prevents clipping the final phoneme while preserving
            the explicit PTT turn boundary; the device still does not decide
            interruption or semantic turn ownership.

    config EIDOLON_PTT_COMMIT_UI_TIMEOUT_MS
        int "PTT commit UI fallback timeout (ms)"
        range 500 10000
        default 5000
        depends on EIDOLON_INTERACTION_MODE_PTT
        help
            Deadman UI timeout after release/commit if the channel does not
            publish agent progress. The channel remains the turn owner; this
            only prevents the display from staying in processing.

    config EIDOLON_PTT_IDLE_FALLBACK_MS
        int "PTT idle teardown fallback timeout (ms)"
        range 0 600000
        default 0
        depends on EIDOLON_HUB_MODE && EIDOLON_INTERACTION_MODE_PTT
        help
            Client-side lifecycle fallback for half-duplex PTT rooms. The
            Channel remains the authoritative idle owner and should send
            session_end before deleting the voice room. This timer only returns
            the device to the control room if that server signal or room-close
            event is missed. Set to 0 to disable.

    config EIDOLON_FULL_DUPLEX_IDLE_FALLBACK_MS
        int "Full-/half-duplex idle teardown fallback timeout (ms)"
        range 0 600000
        default 0
        depends on EIDOLON_HUB_MODE && !EIDOLON_INTERACTION_MODE_PTT
        help
            Client-side lifecycle fallback for non-PTT rooms (full-duplex AND
            half-duplex; half-duplex reuses this timer). The Channel remains the
            authoritative idle owner and should send session_end before deleting
            the voice room. This timer only returns the device to the control
            room if that server signal or room-close event is missed. Set to 0
            to disable.

    config EIDOLON_LIVEKIT_SPEAKER_VOLUME
        int "LiveKit playback volume (0-100)"
        range 0 100
        default 50
        depends on EIDOLON_HUB_MODE

    config EIDOLON_WAKE_WORD_ENABLE
        bool "Enable microWakeWord (hey jarvis) wake word"
        default y
        depends on EIDOLON_HUB_MODE
        help
            Independent microWakeWord path using TFLite (not Espressif WakeNet).
            Say "hey jarvis" to join a LiveKit room when ConfigReady.

    config EIDOLON_GUARD_VISION_BENCHMARK
        bool "Enable ATK guard vision benchmark MCP tool"
        default y
        depends on EIDOLON_HUB_MODE && BOARD_TYPE_ATK_DNESP32S3
        help
            Exposes a user-only, low-rate camera benchmark for EID-12. It measures
            frame capture, luminance-grid motion, and heap/PSRAM usage. It does not
            retain frames, start a voice session, or perform owner verification.

    config EIDOLON_GUARD_SERVICE
        bool "Enable protocol-neutral ATK guard runtime"
        default y
        depends on EIDOLON_HUB_MODE && BOARD_TYPE_ATK_DNESP32S3
        help
            Starts a dormant local guard service with a dedicated FreeRTOS task.
            It remains disabled until a signed GuardBinding runtime config and
            guard.runtime.sync control path explicitly start it.

    config EIDOLON_OWNER_FACE_PROFILE
        bool "Enable Admin-managed Owner Face Profile"
        default y
        depends on EIDOLON_GUARD_SERVICE
        help
            Applies versioned owner reference photos from authenticated Hub pull
            endpoints into an on-device ESP-WHO template database. Raw reference
            images are discarded immediately after enrollment; only local facts
            are produced during live Guard inference.

    config EIDOLON_OWNER_PERSON_PRESENCE
        bool "Enable ATK owner environmental presence"
        default y
        depends on EIDOLON_OWNER_FACE_PROFILE && BOARD_TYPE_ATK_DNESP32S3
        help
            Uses Espressif's TFLite Micro person-detection reference after a
            local owner face match. Person evidence may only renew an existing
            identity session; it can never establish or transfer identity.
            No image, embedding, or inference score leaves the device.

    config EIDOLON_GUARD_SAMPLE_INTERVAL_MS
        int "ATK guard sample interval in milliseconds"
        range 200 5000
        default 500
        depends on EIDOLON_GUARD_SERVICE

    config EIDOLON_GUARD_PREVIEW_INTERVAL_MS
        int "Reserved ATK guard preview refresh interval in milliseconds"
        range 500 5000
        default 1000
        depends on EIDOLON_GUARD_SERVICE
        help
            Retained for the Guard runtime config contract. The current ATK
            runtime has no camera preview output, so this does not affect
            sampling or send any image data over the network.

    config EIDOLON_GUARD_MOTION_THRESHOLD
        int "ATK guard motion threshold"
        range 1 255
        default 18
        depends on EIDOLON_GUARD_SERVICE

    config EIDOLON_GUARD_MOTION_CLEAR_THRESHOLD
        int "ATK guard motion clear threshold"
        range 0 255
        default 9
        depends on EIDOLON_GUARD_SERVICE

    config EIDOLON_GUARD_CANDIDATE_DEBOUNCE_MS
        int "ATK guard candidate debounce in milliseconds"
        range 200 10000
        default 1000
        depends on EIDOLON_GUARD_SERVICE

    config EIDOLON_GUARD_ABSENCE_TIMEOUT_MS
        int "ATK guard absence timeout in milliseconds"
        range 1000 900000
        default 180000
        depends on EIDOLON_GUARD_SERVICE

    config EIDOLON_GUARD_CAPTURE_FAILURE_LIMIT
        int "ATK guard consecutive capture failure limit"
        range 1 60
        default 5
        depends on EIDOLON_GUARD_SERVICE

    config EIDOLON_WAKE_WORD_THRESHOLD
        int "microWakeWord probability cutoff (0-255)"
        range 1 255
        default 128
        depends on EIDOLON_WAKE_WORD_ENABLE
        help
            Quantized detection threshold. 128 ≈ 0.5 (hey_jarvis model default).

    config EIDOLON_WAKE_WORD_COOLDOWN_MS
        int "Wake word cooldown between triggers (ms)"
        range 500 10000
        default 2000
        depends on EIDOLON_WAKE_WORD_ENABLE

endmenu

endmenu
